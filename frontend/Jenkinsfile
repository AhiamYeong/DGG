pipeline {
  agent any
  tools { nodejs 'node20' }
  options { timestamps(); disableConcurrentBuilds() }

  environment {
    FE_DIR      = 'frontend'
    DIST_DIR    = 'dist'
    DEPLOY_DIR  = '/var/www/app'
    RELEASE_DIR = '/var/www/app_releases'
    DOMAIN      = 'https://j13a305.p.ssafy.io'
    API_BASE    = '/api'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    // 가짜 URL이 남아있으면 실패시켜서 바로 잡게 함
    stage('Preflight: placeholder URL guard') {
      steps {
        dir("${FE_DIR}") {
          sh '''
            set -eu
            if grep -RIn "your-backend-server.com" .; then
              echo "[ERROR] Found placeholder domain 'your-backend-server.com'. Replace with import.meta.env.VITE_API_BASE";
              exit 1
            fi
          '''
        }
      }
    }

    // .env.production 생성: API_BASE + 네이버 지도 clientId 주입
    stage('Write .env.production (public only)') {
      steps {
        dir("${FE_DIR}") {
          withCredentials([string(credentialsId: 'naver_map_client_id', variable: 'NAVER_ID')]) {
            sh '''
              set -eu
              cat > .env.production <<EOF
VITE_API_BASE=${API_BASE}
VITE_NAVER_MAP_CLIENT_ID=${NAVER_ID}
EOF
              echo "[info] Wrote .env.production"
            '''
          }
        }
      }
    }

    stage('Install & Build') {
      steps {
        dir("${FE_DIR}") {
          sh '''
            set -eux
            if [ -f package-lock.json ]; then npm ci; else npm i; fi
            # 타입 에러가 지금 많으면 아래 한 줄로 바꿔 임시 통과 가능:
            # npx vite build
            npm run build
          '''
        }
      }
    }

    stage('Backup & Deploy') {
      steps {
        sh '''
          set -eux
          ts=$(date +%Y%m%d%H%M%S)

          if [ -d ${DEPLOY_DIR} ] && [ "$(ls -A ${DEPLOY_DIR})" ]; then
            mkdir -p ${RELEASE_DIR}/release-${ts}
            rsync -a ${DEPLOY_DIR}/ ${RELEASE_DIR}/release-${ts}/
          fi

          rsync -av --delete ${FE_DIR}/${DIST_DIR}/ ${DEPLOY_DIR}/
        '''
      }
    }

    stage('Health Check') {
      steps {
        sh 'set -eux; curl -I --fail ${DOMAIN}/'
      }
    }
  }

  post {
    always { cleanWs() }
  }
}
